@model UniversityLibraryMVC.Models.Book
@{
    ViewData["Title"] = "Book Details";
    var university = ViewBag.University as UniversityLibraryMVC.Models.University;
}

<partial name="_UniversityBrandingPartial" model="university" />

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">Book Details</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">ISBN</dt>
                    <dd class="col-sm-8">@Model.ISBN</dd>

                    <dt class="col-sm-4">Title</dt>
                    <dd class="col-sm-8">@Model.Title</dd>

                    <dt class="col-sm-4">Author</dt>
                    <dd class="col-sm-8">@Model.Author</dd>

                    <dt class="col-sm-4">Publisher</dt>
                    <dd class="col-sm-8">@Model.Publisher</dd>

                    <dt class="col-sm-4">Publication Year</dt>
                    <dd class="col-sm-8">@Model.PublicationYear</dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@Model.Category</dd>

                    <dt class="col-sm-4">Total Copies</dt>
                    <dd class="col-sm-8">@Model.TotalCopies</dd>

                    <dt class="col-sm-4">Available Copies</dt>
                    <dd class="col-sm-8">@Model.AvailableCopies</dd>
                </dl>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.BookID" class="btn btn-warning me-2">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.BookID" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this book?');">
                    <i class="bi bi-trash me-1"></i> Delete
                </a>
            </div>
        </div>
    </div>
</div>
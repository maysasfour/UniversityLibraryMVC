@model List<UniversityLibraryMVC.Models.Book>
@{
    ViewData["Title"] = "Books Management";
    var university = ViewBag.University as UniversityLibraryMVC.Models.University;
}

<partial name="_UniversityBrandingPartial" model="university" />

<div class="card mb-4">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h5 class="card-title mb-0">Books Management</h5>
            </div>
            <div class="col-md-6 text-md-end mt-2 mt-md-0">
                <a asp-action="Create" class="btn btn-primary">
                    Add New Book
                </a>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <form asp-action="Index" method="get">
                    <div class="input-group">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Search books..." value="@ViewData["CurrentFilter"]" />
                        <button type="submit" class="btn btn-outline-secondary">Search</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ISBN</th>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Category</th>
                        <th>Available/Total</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model)
                    {
                        <tr>
                            <td>@book.ISBN</td>
                            <td>@book.Title</td>
                            <td>@book.Author</td>
                            <td>@book.Category</td>
                            <td class="@(book.AvailableCopies > 0 ? "text-success fw-bold" : "text-danger fw-bold")">
                                @book.AvailableCopies/@book.TotalCopies
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@book.BookID" class="btn btn-sm btn-info">View</a>
                                <a asp-action="Edit" asp-route-id="@book.BookID" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@book.BookID" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this book?');">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@model UniversityLibraryMVC.Models.Book
@{
    ViewData["Title"] = "Delete Book";
    var university = ViewBag.University as UniversityLibraryMVC.Models.University;
}

<partial name="_UniversityBrandingPartial" model="university" />

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">Delete Book</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <h6><i class="bi bi-exclamation-triangle me-2"></i> Are you sure you want to delete this book?</h6>
            <p>This action cannot be undone.</p>
        </div>

        <div class="row">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">ISBN</dt>
                    <dd class="col-sm-8">@Model.ISBN</dd>

                    <dt class="col-sm-4">Title</dt>
                    <dd class="col-sm-8">@Model.Title</dd>

                    <dt class="col-sm-4">Author</dt>
                    <dd class="col-sm-8">@Model.Author</dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@Model.Category</dd>
                </dl>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Cancel
            </a>
            <form asp-action="DeleteConfirmed" asp-route-id="@Model.BookID" method="post">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i> Delete Book
                </button>
            </form>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Test Admin Creation";
}

<h2>Test Admin Creation</h2>

@if (ViewBag.Message != null)
{
    <div class="alert alert-success">
        @ViewBag.Message
    </div>
}

<form asp-action="CreateAdmin" method="post">
    <button type="submit" class="btn btn-primary">Create/Reset Admin User</button>
</form>

<div class="mt-3">
    <a href="/Identity/Account/Login" class="btn btn-secondary">Go to Login</a>
</div>
@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    var university = ViewBag.University as University;
    if (university == null)
    {
        university = new University
        {
            PrimaryColor = "#003366",
            SecondaryColor = "#FFD700",
            LogoPath = "/images/menu-university-logo.png"
        };
    }
}

<partial name="_UniversityBrandingPartial" model="university" />

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Error</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-danger">
                    <h5 class="alert-heading">
                        <i class="bi bi-exclamation-octagon me-2"></i>
                        An error occurred while processing your request.
                    </h5>
                    <p class="mb-3">
                        We apologize for the inconvenience. Please try again later or contact support if the problem persists.
                    </p>

                    @if (Model?.ShowRequestId ?? false)
                    {
                        <p class="mb-0">
                            <strong>Request ID:</strong> <code>@Model.RequestId</code>
                        </p>
                    }
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-house me-1"></i> Return to Home
                    </a>
                    <button onclick="location.reload();" class="btn btn-primary">
                        <i class="bi bi-arrow-repeat me-1"></i> Try Again
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
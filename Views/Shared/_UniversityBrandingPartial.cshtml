@model UniversityLibraryMVC.Models.University

@{
    var logoPath = !string.IsNullOrWhiteSpace(Model?.LogoPath) ? Model.LogoPath : "/Images/meu-university-logo.png";
}

<div class="home-hero reveal-on-load">
    <div class="home-hero-content">
        <div class="hero-brand">
            <img src="@logoPath" class="hero-logo" alt="@(Model?.Name ?? "Middle East University") Logo" />
            <span>Middle East University Library</span>
        </div>
        <h1>Manage books, members, and borrowing in one clean library workspace.</h1>
        <p>
            A focused system for cataloging university books, tracking active loans, monitoring overdue items,
            and keeping member records organized.
        </p>
        <div class="hero-actions">
            <a asp-controller="Books" asp-action="Index" class="btn btn-light btn-lg">
                <i class="bi bi-book me-2"></i>Browse Catalog
            </a>
            <a asp-controller="Books" asp-action="Create" class="btn btn-secondary btn-lg">
                <i class="bi bi-plus-circle me-2"></i>Add Book
            </a>
        </div>
    </div>
    <div class="home-hero-panel">
        <div class="orbit-card orbit-card-one">
            <i class="bi bi-journal-bookmark"></i>
            <span>Catalog</span>
        </div>
        <div class="orbit-card orbit-card-two">
            <i class="bi bi-people"></i>
            <span>Members</span>
        </div>
        <div class="orbit-card orbit-card-three">
            <i class="bi bi-arrow-left-right"></i>
            <span>Loans</span>
        </div>
    </div>
</div>

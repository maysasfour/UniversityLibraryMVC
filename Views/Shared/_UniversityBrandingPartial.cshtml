@model UniversityLibraryMVC.Models.University

@{
    var logoPath = !string.IsNullOrWhiteSpace(Model?.LogoPath) ? Model.LogoPath : "/Images/meu-university-logo.png";
}

<div class="home-hero reveal-on-load">
    <div class="home-hero-content">
        <div class="hero-brand">
            <img src="@logoPath" class="hero-logo" alt="@(Model?.Name ?? "Middle East University") Logo" />
            <span>Middle East University</span>
        </div>
        <h1>A refined digital library system for modern campus operations.</h1>
        <p>
            Manage the catalog, members, and loans from a clean workspace designed for administrators,
            students, and decision makers.
        </p>
        <div class="hero-actions">
            <a asp-controller="Books" asp-action="Index" class="btn btn-primary btn-lg">
                <i class="bi bi-book me-2"></i>Browse Catalog
            </a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary btn-lg">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </a>
        </div>
        <div class="investor-strip">
            <span><strong>Clear</strong> library operations</span>
            <span><strong>Fast</strong> member onboarding</span>
            <span><strong>Ready</strong> for cloud deployment</span>
        </div>
    </div>
    <div class="home-hero-panel">
        <div class="orbit-card orbit-card-one">
            <i class="bi bi-journal-bookmark"></i>
            <span>Catalog</span>
        </div>
        <div class="orbit-card orbit-card-two">
            <i class="bi bi-people"></i>
            <span>Members</span>
        </div>
        <div class="orbit-card orbit-card-three">
            <i class="bi bi-arrow-left-right"></i>
            <span>Loans</span>
        </div>
    </div>
</div>

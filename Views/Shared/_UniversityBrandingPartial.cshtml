@model UniversityLibraryMVC.Models.University

<div class="university-branding mb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex align-items-center">
                @if (Model != null && !string.IsNullOrEmpty(Model.LogoPath))
                {
                    <img src="@Model.LogoPath" class="university-logo me-3" alt="@(Model.Name ?? "University") Logo" style="max-height: 60px;" />
                }
                <div>
                    <h1 class="mb-0">@(Model?.Name ?? "University Library")</h1>
                    <p class="mb-0 text-muted">Library Management System</p>
                </div>
            </div>
        </div>
    </div>
</div>
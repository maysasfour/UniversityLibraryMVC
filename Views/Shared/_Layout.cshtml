<!DOCTYPE html>
@{
    var university = ViewBag.University as University;
    if (university == null)
    {
        university = new University
        {
            Name = "Middle East University",
            PrimaryColor = "#003366",
            SecondaryColor = "#FFD700",
            LogoPath = "/Images/meu-university-logo.png"
        };
    }
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Middle East University Library</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/university-theme.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css">

    <style>
        :root {
            --primary-color: @university.PrimaryColor;
            --secondary-color: @university.SecondaryColor;
        }

        .navbar {
            background-color: var(--primary-color) !important;
        }

        .navbar-brand, .nav-link {
            color: white !important;
        }

        .btn-primary {
            background-color: var(--primary-color) !important;
            border-color: var(--primary-color) !important;
        }

        .btn-secondary {
            background-color: var(--secondary-color) !important;
            border-color: var(--secondary-color) !important;
            color: #333 !important;
        }

        .card-header {
            background-color: var(--primary-color) !important;
            color: white !important;
        }

        .table th {
            background-color: var(--primary-color) !important;
            color: white !important;
        }

        .footer {
            background-color: var(--primary-color) !important;
            color: white !important;
        }

        .alert-validation {
            background-color: #fff3cd;
            color: #856404;
            border-color: #ffeeba;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    @{
                        string logoPath = "/Images/meu-university-logo.png";
                        if (university != null)
                        {
                            if (!string.IsNullOrEmpty(university.LogoPath))
                            {
                                logoPath = university.LogoPath;
                            }
                            else
                            {
                               
                                logoPath = "/Images/universities/meu-university-logo.png";
                            }
                        }
                    }
                    <img src="@logoPath" class="university-logo" alt="Meu University Logo" />
                    <span>Middle East University Library</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Books" asp-action="Index">Books</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Members" asp-action="Index">Members</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Loans" asp-action="Index">Loans</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Universities" asp-action="Index">Universities</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Xml" asp-action="Index">XML Management</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-shell">
        <main role="main" class="pb-3">
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @ViewBag.SuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @ViewBag.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!(ViewData["HidePageHeader"] as bool? ?? false))
            {
                <section class="page-heading reveal-on-load">
                    <div class="page-heading-brand">
                        <img src="@(!string.IsNullOrWhiteSpace(university.LogoPath) ? university.LogoPath : "/Images/meu-university-logo.png")" class="page-heading-logo" alt="@(university.Name ?? "University") Logo" />
                        <div>
                            <p class="eyebrow mb-1">Middle East University</p>
                            <h1>@(ViewData["Title"] ?? "Library")</h1>
                        </div>
                    </div>
                    <div class="page-heading-actions">
                        <a asp-controller="Books" asp-action="Index" class="btn btn-light btn-sm"><i class="bi bi-search me-1"></i>Browse Books</a>
                        <a asp-controller="Loans" asp-action="Create" class="btn btn-secondary btn-sm"><i class="bi bi-arrow-left-right me-1"></i>New Loan</a>
                    </div>
                </section>
            }

            <div class="content-reveal">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="footer mt-auto py-3">
        <div class="container text-center">
            <span>&copy; @DateTime.Now.Year - Middle East University Library System</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/validation.js"></script>
    <script src="~/js/xml.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

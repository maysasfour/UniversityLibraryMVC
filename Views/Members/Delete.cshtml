@model UniversityLibraryMVC.Models.Member
@{
    ViewData["Title"] = "Delete Member";
    var university = ViewBag.University as UniversityLibraryMVC.Models.University;
}

<partial name="_UniversityBrandingPartial" model="university" />

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">Delete Member</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <h6><i class="bi bi-exclamation-triangle me-2"></i> Are you sure you want to delete this member?</h6>
            <p>This action cannot be undone.</p>
        </div>

        <div class="row">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Student ID</dt>
                    <dd class="col-sm-8">@Model.StudentID</dd>

                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Cancel
            </a>
            <form asp-action="DeleteConfirmed" asp-route-id="@Model.MemberID" method="post">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i> Delete Member
                </button>
            </form>
        </div>
    </div>
</div>
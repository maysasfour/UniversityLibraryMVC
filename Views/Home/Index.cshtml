@model UniversityLibraryMVC.Models.HomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["HidePageHeader"] = true;
    var university = ViewBag.University as UniversityLibraryMVC.Models.University;
    var hasBooks = Model.RecentBooks.Any();
    var hasLoans = Model.RecentLoans.Any();
}

<partial name="_UniversityBrandingPartial" model="university" />

<section class="metric-grid">
    <article class="metric-card">
        <div class="metric-icon"><i class="bi bi-book"></i></div>
        <div>
            <span>Total Books</span>
            <strong>@Model.TotalBooks</strong>
        </div>
    </article>
    <article class="metric-card">
        <div class="metric-icon success"><i class="bi bi-people"></i></div>
        <div>
            <span>Active Members</span>
            <strong>@Model.TotalMembers</strong>
        </div>
    </article>
    <article class="metric-card">
        <div class="metric-icon info"><i class="bi bi-arrow-left-right"></i></div>
        <div>
            <span>Active Loans</span>
            <strong>@Model.ActiveLoans</strong>
        </div>
    </article>
    <article class="metric-card">
        <div class="metric-icon warning"><i class="bi bi-exclamation-triangle"></i></div>
        <div>
            <span>Overdue Loans</span>
            <strong>@Model.OverdueLoans</strong>
        </div>
    </article>
</section>

<section class="investor-grid">
    <article>
        <i class="bi bi-graph-up-arrow"></i>
        <h3>Built For Scalable Operations</h3>
        <p>Centralized catalog, loans, and members reduce manual work and make library performance easier to measure.</p>
    </article>
    <article>
        <i class="bi bi-shield-check"></i>
        <h3>Secure Account Access</h3>
        <p>Role-based Identity authentication supports administrator workflows and member self-service registration.</p>
    </article>
    <article>
        <i class="bi bi-cloud-check"></i>
        <h3>Cloud Deployment Ready</h3>
        <p>The system is prepared for Render deployment with persistent configuration and production-focused startup logic.</p>
    </article>
</section>

<section class="row g-4 align-items-stretch">
    <div class="col-lg-8">
        <div class="surface-panel h-100">
            <div class="panel-title-row">
                <div>
                    <p class="eyebrow">Catalog</p>
                    <h2>Latest Books</h2>
                </div>
                <a asp-controller="Books" asp-action="Index" class="btn btn-outline-primary btn-sm">
                    View All <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>

            @if (hasBooks)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle app-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Author</th>
                                <th>Category</th>
                                <th>Available</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var book in Model.RecentBooks)
                            {
                                <tr>
                                    <td>
                                        <strong>@book.Title</strong>
                                        <small class="d-block text-muted">@book.ISBN</small>
                                    </td>
                                    <td>@book.Author</td>
                                    <td>@book.Category</td>
                                    <td class="@(book.AvailableCopies > 0 ? "text-success fw-bold" : "text-danger fw-bold")">
                                        @book.AvailableCopies/@book.TotalCopies
                                    </td>
                                    <td>
                                        <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookID" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-controller="Loans" asp-action="Create" asp-route-bookId="@book.BookID" class="btn btn-sm btn-primary">
                                            Borrow
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-journal-plus"></i>
                    <h3>No books in the catalog yet</h3>
                    <p>Start by adding the first real university library book. Demo records have been removed.</p>
                    <a asp-controller="Books" asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Add First Book
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="surface-panel h-100">
            <div class="panel-title-row">
                <div>
                    <p class="eyebrow">Circulation</p>
                    <h2>Recent Loans</h2>
                </div>
                <a asp-controller="Loans" asp-action="Index" class="btn btn-outline-primary btn-sm">
                    View
                </a>
            </div>

            @if (hasLoans)
            {
                <ul class="activity-list">
                    @foreach (var loan in Model.RecentLoans)
                    {
                        <li>
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">@loan.Book?.Title</h6>
                                    <small class="text-muted">@loan.Member?.Name</small>
                                    <div class="mt-1">
                                        <span class="badge bg-@(loan.Status == "Active" ? "primary" : loan.Status == "Returned" ? "success" : "warning")">
                                            @loan.Status
                                        </span>
                                        @if (loan.FineAmount > 0)
                                        {
                                            <span class="badge bg-danger">Fine: @loan.FineAmount.ToString("C")</span>
                                        }
                                    </div>
                                </div>
                                <div class="ms-3">
                                    <a asp-controller="Loans" asp-action="Details" asp-route-id="@loan.LoanID" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty-state compact">
                    <i class="bi bi-arrow-left-right"></i>
                    <h3>No loans yet</h3>
                    <p>Create a loan after adding books and members.</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="quick-action-band">
    <a asp-controller="Books" asp-action="Create">
        <i class="bi bi-book"></i>
        <span>Add Book</span>
    </a>
    <a asp-controller="Members" asp-action="Create">
        <i class="bi bi-person-plus"></i>
        <span>Add Member</span>
    </a>
    <a asp-controller="Loans" asp-action="Create">
        <i class="bi bi-arrow-left-right"></i>
        <span>New Loan</span>
    </a>
    <a asp-controller="Xml" asp-action="Index">
        <i class="bi bi-filetype-xml"></i>
        <span>XML Tools</span>
    </a>
</section>

<section class="vision-band">
    <div>
        <p class="eyebrow">Investor Snapshot</p>
        <h2>From basic library records to a digital campus service platform.</h2>
        <p>
            The application now presents a professional, branded experience while keeping the core workflows practical:
            catalog management, member onboarding, loan tracking, XML import/export, and dashboard visibility.
        </p>
    </div>
    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-light btn-lg">
        <i class="bi bi-person-plus me-2"></i>Try Sign Up
    </a>
</section>

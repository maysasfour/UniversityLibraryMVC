@model UniversityLibraryMVC.Models.Loan
@{
    ViewData["Title"] = "Return Book";
    var university = ViewBag.University as UniversityLibraryMVC.Models.University;
}

<partial name="_UniversityBrandingPartial" model="university" />

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">Return Book</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-success">
            <h6><i class="bi bi-check-circle me-2"></i> Book successfully returned!</h6>
        </div>

        <div class="row">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Book</dt>
                    <dd class="col-sm-8">@Model.Book?.Title</dd>

                    <dt class="col-sm-4">Member</dt>
                    <dd class="col-sm-8">@Model.Member?.Name</dd>

                    <dt class="col-sm-4">Loan Date</dt>
                    <dd class="col-sm-8">@Model.LoanDate.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-4">Due Date</dt>
                    <dd class="col-sm-8">@Model.DueDate.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-4">Return Date</dt>
                    <dd class="col-sm-8">@Model.ReturnDate?.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@Model.Status</dd>

                    <dt class="col-sm-4">Fine Amount</dt>
                    <dd class="col-sm-8">@Model.FineAmount.ToString("C")</dd>
                </dl>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Loans
            </a>
            <a asp-action="Details" asp-route-id="@Model.LoanID" class="btn btn-primary">
                <i class="bi bi-eye me-1"></i> View Details
            </a>
        </div>
    </div>
</div>
@model UniversityLibraryMVC.Models.LoanViewModel
@{
    ViewData["Title"] = "Edit Loan";
    var university = ViewBag.University as UniversityLibraryMVC.Models.University;
}

<partial name="_UniversityBrandingPartial" model="university" />

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Edit Loan</h5></div>
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" asp-for="SelectedLoanId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="SelectedBookId" class="form-label"></label>
                    <select asp-for="SelectedBookId" class="form-control" asp-items="@(new SelectList(Model.Books, "BookID", "Title"))"><option value="">-- Select Book --</option></select>
                    <span asp-validation-for="SelectedBookId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SelectedMemberId" class="form-label"></label>
                    <select asp-for="SelectedMemberId" class="form-control" asp-items="@(new SelectList(Model.Members, "MemberID", "Name"))"><option value="">-- Select Member --</option></select>
                    <span asp-validation-for="SelectedMemberId" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6"><label asp-for="LoanDate" class="form-label"></label><input asp-for="LoanDate" type="date" class="form-control" /><span asp-validation-for="LoanDate" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" type="date" class="form-control" /><span asp-validation-for="DueDate" class="text-danger"></span></div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6"><label asp-for="ReturnDate" class="form-label"></label><input asp-for="ReturnDate" type="date" class="form-control" /><span asp-validation-for="ReturnDate" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-control"><option value="Active">Active</option><option value="Returned">Returned</option><option value="Overdue">Overdue</option></select><span asp-validation-for="Status" class="text-danger"></span></div>
            </div>
            <div class="row mb-3"><div class="col-md-6"><label asp-for="FineAmount" class="form-label"></label><input asp-for="FineAmount" type="number" class="form-control" step="0.01" min="0" /><span asp-validation-for="FineAmount" class="text-danger"></span></div></div>
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
                <div><button type="submit" class="btn btn-primary me-2"><i class="bi bi-save me-1"></i> Save Changes</button><a asp-action="Delete" asp-route-id="@Model.SelectedLoanId" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this loan?');"><i class="bi bi-trash me-1"></i> Delete</a></div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

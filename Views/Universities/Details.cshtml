@model UniversityLibraryMVC.Models.University
@{
    ViewData["Title"] = "University Details";
}

<partial name="_UniversityBrandingPartial" model="Model" />

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">University Details</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">Primary Color</dt>
            <dd class="col-sm-8">@Model.PrimaryColor</dd>
            <dt class="col-sm-4">Secondary Color</dt>
            <dd class="col-sm-8">@Model.SecondaryColor</dd>
            <dt class="col-sm-4">Logo Path</dt>
            <dd class="col-sm-8">@Model.LogoPath</dd>
            <dt class="col-sm-4">Menu Position</dt>
            <dd class="col-sm-8">@Model.MenuPosition</dd>
        </dl>
        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.UniversityID" class="btn btn-warning me-2">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.UniversityID" class="btn btn-danger">Delete</a>
            </div>
        </div>
    </div>
</div>

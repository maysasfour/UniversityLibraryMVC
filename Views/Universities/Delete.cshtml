@model UniversityLibraryMVC.Models.University
@{
    ViewData["Title"] = "Delete University";
    var university = ViewBag.University as UniversityLibraryMVC.Models.University;
}

<partial name="_UniversityBrandingPartial" model="university" />

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">Delete University</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <h6><i class="bi bi-exclamation-triangle me-2"></i> Are you sure you want to delete this university?</h6>
            <p>This action cannot be undone.</p>
        </div>

        <div class="row">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Primary Color</dt>
                    <dd class="col-sm-8">@Model.PrimaryColor</dd>

                    <dt class="col-sm-4">Secondary Color</dt>
                    <dd class="col-sm-8">@Model.SecondaryColor</dd>

                    <dt class="col-sm-4">Logo Path</dt>
                    <dd class="col-sm-8">@Model.LogoPath</dd>

                    <dt class="col-sm-4">Menu Position</dt>
                    <dd class="col-sm-8">@Model.MenuPosition</dd>
                </dl>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Cancel
            </a>
            <form asp-action="DeleteConfirmed" asp-route-id="@Model.UniversityID" method="post">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i> Delete University
                </button>
            </form>
        </div>
    </div>
</div>